{
  "name": "@saucelabs/storybook-variants",
  "version": "0.3.0",
  "description": "Display multiple variations of a component automatically in a grid.",
  "keywords": [
    "storybook-addons",
    "storybook",
    "variants",
    "visual-testing"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saucelabs/visual-sdks.git",
    "directory": "visual-js/visual-storybook-variants"
  },
  "author": "SauceLabs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./manager": "./dist/manager.mjs",
    "./preview": "./dist/preview.mjs",
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md",
    "*.js",
    "*.d.ts"
  ],
  "scripts": {
    "build": "tsup-node",
    "build:watch": "npm run build -- --watch",
    "start": "run-p build:watch 'storybook --quiet'",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint \"src/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@changesets/cli": "2.27.1",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/addon-links": "^10.5.6",
    "@storybook/icons": "^2.1.0",
    "@storybook/react": "^10.5.6",
    "@storybook/react-vite": "^10.5.6",
    "@types/lodash": "4.14.202",
    "@types/node": "^24",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "cartesian": "^1.0.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "lodash": "^4.17.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.0.3",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "storybook": "^10.5.6",
    "tsup": "^8.5.1",
    "typescript": "^5.2.2",
    "vite": "^7"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bundler": {
    "exportEntries": [
      "src/index.ts"
    ],
    "managerEntries": [
      "src/manager.ts"
    ],
    "previewEntries": [
      "src/preview.ts"
    ]
  },
  "storybook": {
    "displayName": "Storybook Variants",
    "supportedFrameworks": [
      "react"
    ],
    "icon": "https://user-images.githubusercontent.com/321738/63501763-88dbf600-c4cc-11e9-96cd-94adadc2fd72.png"
  },
  "peerDependencies": {
    "storybook": "^10.0.0",
    "react": "^18.0.0 || ^19.0.0"
  }
}
